# Primary: Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Backup: Cerebras (free tier), same model family. Used only if Groq fails.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Optional extra fallbacks (OpenAI-compatible), tried after Groq/Cerebras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
XAI_API_KEY=
XAI_MODEL=grok-3-mini
GEMINI_MODEL_B=gemini-3.1-flash-lite
